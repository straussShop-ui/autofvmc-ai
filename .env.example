# Public frontend value: no secrets
VITE_AUTOFVMC_GATEWAY_URL=https://gateway.yourdomain.com

# Protected gateway values: keep on internal machine only
AUTOFVMC_HOST=0.0.0.0
AUTOFVMC_PORT=47880
